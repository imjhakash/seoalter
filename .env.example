# ===========================================
# SEOGAP - Environment Variables
# ===========================================
# REQUIRED: These environment variables MUST be set for the application to work
# Set these in Vercel Dashboard > Project > Settings > Environment Variables

# ===========================================
# REQUIRED: API Keys
# ===========================================

# SerpAPI Key - Get from https://serpapi.com/
# REQUIRED for search functionality
SERP_API_KEY=your_serpapi_key_here

# OpenAI API Key - Get from https://platform.openai.com/api-keys  
# REQUIRED for AI analysis and chat
OPENAI_API_KEY=sk-your_openai_key_here

# ===========================================
# REQUIRED: Database
# ===========================================

# MongoDB Connection String
# REQUIRED for storing search history
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# ===========================================
# HOW TO ADD TO VERCEL:
# ===========================================
# 1. Go to https://vercel.com/dashboard
# 2. Select your project
# 3. Go to Settings > Environment Variables
# 4. Add each variable above with your actual values
# 5. Redeploy for changes to take effect

# ===========================================
# LOCAL DEVELOPMENT:
# ===========================================
# 1. Copy this file to .env.local
# 2. Replace placeholder values with your actual API keys
# 3. Run: npm run dev

# ===========================================
# NOTES:
# ===========================================
# - API keys are now ONLY read from environment variables
# - Never commit .env.local to version control
# - Keep your API keys secure and never share them
